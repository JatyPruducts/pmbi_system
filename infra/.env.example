# Скопируйте в infra/.env и подставьте значения.
# Используется docker compose при запуске из каталога infra/.

# --- Образы (теги Docker Hub) ---
NGINX_IMAGE=1.25-alpine
POSTGRES_IMAGE=16-alpine
MONGO_IMAGE=7
REDIS_IMAGE=7-alpine
RABBITMQ_IMAGE=3-management-alpine

# --- Порты на хосте ---
NGINX_HTTP_PORT=80
API_PORT=8000
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL (должны совпадать с URL ниже, если задаёте свои учётные данные) ---
POSTGRES_USER=pmbi
POSTGRES_PASSWORD=pmbi
POSTGRES_DB=pmbi

# --- RabbitMQ (если меняете логин/пароль — задайте CELERY_BROKER_URL вручную) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Приложение API / Celery (сеть Docker: имена сервисов postgres, mongo, redis, rabbitmq) ---
DATABASE_URL=postgresql+asyncpg://pmbi:pmbi@postgres:5432/pmbi
SYNC_DATABASE_URL=postgresql://pmbi:pmbi@postgres:5432/pmbi
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=pmbi
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

JWT_SECRET=replace-with-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Celery worker ---
CELERY_LOG_LEVEL=info
